# --- Demographic Analysis of RACE vs Readmission ---#

race_crosstab = pd.crosstab(cohort['race'], cohort['readmitted_30d'])
race_pct = pd.crosstab(cohort['race'], cohort['readmitted_30d'], normalize='index') * 100

race_summary = pd.DataFrame({
    'Total_Patients': race_crosstab.sum(axis=1),
    'No_Readmission_(n)': race_crosstab[0],
    'Readmitted_(n)': race_crosstab[1],
    'Readmission_Rate_(%)': race_pct[1]
}).reset_index()

race_summary = race_summary.sort_values(by='Readmission_Rate_(%)', ascending=False)
print(race_summary.round(2).to_string(index=False))

chi2_stat, p_value_chi2, dof, expected = chi2_contingency(race_crosstab)

print(f"Chi2 Statistic: {chi2_stat:.4f}")
print(f"P-value: {p_value_chi2:.4e}")

race_totals = cohort.groupby('race').size()

plt.figure(figsize=(14, 7)) 
ax = sns.countplot(
    x='race', 
    hue='readmitted_30d', 
    data=cohort, 
    palette={0: "#87CEEB", 1: "#ff9999"}
)
plt.title('Comparison of Readmissions and Non-Readmissions by Race', fontsize=14, fontweight='bold')
plt.xlabel('Race / Ethnicity', fontsize=12)
plt.ylabel('Number of Patients', fontsize=12)
plt.xticks(rotation=15)
plt.ylim(0, cohort['race'].value_counts().max() * 1.15)
plt.grid(axis='y', linestyle='--', alpha=0.7)
handles, _ = ax.get_legend_handles_labels()
ax.legend(handles, ['No Readmission (0)', 'Readmitted (1)'], title='Status', loc='upper right')
races_on_x_axis = [tick.get_text() for tick in ax.get_xticklabels()]
num_races = len(races_on_x_axis)
for i, p in enumerate(ax.patches):
    height = p.get_height()
    if height > 0 and height == height: 
        current_race = races_on_x_axis[i % num_races]
        total_for_this_race = race_totals[current_race]
        percentage = (height / total_for_this_race) * 100
        annotation_text = f'{int(height)}\n({percentage:.1f}%)'
        ax.annotate(annotation_text, 
                    (p.get_x() + p.get_width() / 2., height), 
                    ha='center', va='bottom', 
                    xytext=(0, 5), 
                    textcoords='offset points',
                    fontsize=10, fontweight='bold')
plt.tight_layout()
plt.show()


