# --- LOS and ICU type for Readmission --- #

def q25(x): return x.quantile(0.25)
def q75(x): return x.quantile(0.75)

los_stats = cohort.groupby(['first_careunit', 'readmitted_30d'])['los'].agg(
    Patients_Count='count',
    Mean_LOS='mean',
    Median_LOS='median',
    Q1_LOS=q25,
    Q3_LOS=q75
).round(2).reset_index()

los_stats['readmitted_30d'] = los_stats['readmitted_30d'].map(
    {0: 'No (Single Stay)', 1: 'Yes (Readmitted)'}
)

los_stats.rename(columns={
    'first_careunit': 'ICU Type',
    'readmitted_30d': 'Readmission < 30d'
}, inplace=True)

print(los_stats.to_string(index=False))

los_no = cohort[cohort['readmitted_30d'] == 0]['los'].dropna()
los_yes = cohort[cohort['readmitted_30d'] == 1]['los'].dropna()

stat_mw, p_value_mw = mannwhitneyu(los_yes, los_no, alternative='two-sided')

print("   Test: Mann-Whitney U Test for LOS")
print(f"   P-value: {p_value_mw:.4e}")

icu_crosstab = pd.crosstab(cohort['first_careunit'], cohort['readmitted_30d'])
chi2_stat, p_value_chi2, dof, expected = chi2_contingency(icu_crosstab)

print("   Test: Chi-Square (χ²) Test of Independence for ICU type")
print(f"   P-value: {p_value_chi2:.4e}")

cohort['careunit_short'] = cohort['first_careunit'].str.extract(r'\((.*?)\)', expand=False).fillna(cohort['first_careunit'])

