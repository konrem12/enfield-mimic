Plot C: Feature extraction via Permutation

current_test_set = X_test_fused 

if len(current_test_set.shape) == 2:
    X_test_reshaped = np.expand_dims(current_test_set.values, axis=1)
else:
    X_test_reshaped = current_test_set # Αν είναι ήδη 3D, το αφήνουμε ως έχει

baseline_preds = model.predict(X_test_reshaped, verbose=0)
baseline_auc = roc_auc_score(y_test, baseline_preds)

importances = []
cols_to_drop = [c for c in ['subject_id', 'hadm_id', 'readmitted_30d'] if c in current_test_set.columns]
feature_names = current_test_set.drop(columns=cols_to_drop).columns if hasattr(current_test_set, 'columns') else [f"Feature_{i}" for i in range(X_test_reshaped.shape[2])]

for i in range(X_test_reshaped.shape[2]): 
    X_test_permuted = X_test_reshaped.copy()
    
    np.random.shuffle(X_test_permuted[:, 0, i])
    
    permuted_preds = model.predict(X_test_permuted, verbose=0)
    permuted_auc = roc_auc_score(y_test, permuted_preds)
    
    drop_in_auc = max(0, baseline_auc - permuted_auc)
    importances.append(drop_in_auc)

importance_dict = dict(zip(feature_names, importances))

top_15_lstm = sorted(importance_dict.items(), key=lambda x: x[1], reverse=True)[:15]
features_lstm = [x[0] for x in top_15_lstm]
scores_lstm = [x[1] for x in top_15_lstm]

plt.figure(figsize=(10, 8))
plt.barh(features_lstm[::-1], scores_lstm[::-1], color='indigo')
plt.xlabel('Decrease in ROC-AUC Score (Permutation Importance)')
plt.title('Top 15 Feature Importances (Causal-LSTM via Permutation)')
plt.grid(axis='x', linestyle='--', alpha=0.7)
plt.show()
