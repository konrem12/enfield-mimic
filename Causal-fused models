### 2. Causal fused LSTM ###

X_train_lstm_fused = X_train_imputed.copy()
X_test_lstm_fused = X_test_imputed.copy()

X_train_lstm_fused['Causal_Effect_LOS'] = cate_train
X_test_lstm_fused['Causal_Effect_LOS'] = cate_test

features_count = X_train_lstm_fused.shape[1]

# Μετατροπή σε 3D Array για το LSTM: (Αριθμός Ασθενών, 1 Χρονικό Βήμα, Αριθμός Μεταβλητών)
X_train_lstm_3d = np.array(X_train_lstm_fused).reshape((X_train_lstm_fused.shape[0], 1, features_count))
X_test_lstm_3d = np.array(X_test_lstm_fused).reshape((X_test_lstm_fused.shape[0], 1, features_count))

print(f"Fused LSTM Input Shape: {X_train_lstm_3d.shape} (includes Causal_Effect_LOS)")

class_weights = compute_class_weight(
    class_weight='balanced', 
    classes=np.unique(y_train), 
    y=y_train
)
weight_dict = {0: class_weights[0], 1: class_weights[1]}

model = Sequential()

model.add(LSTM(64, 
    input_shape=(1, features_count), 
    activation='tanh'
))
model.add(BatchNormalization())
model.add(Dropout(0.5)) 

model.add(Dense(
    32, 
    activation='relu'
))
model.add(Dropout(0.4))

model.add(Dense(1, activation='sigmoid'))

model.compile(
    optimizer=tf.keras.optimizers.Adam(learning_rate=0.0005), 
    loss='binary_crossentropy',
    metrics=[tf.keras.metrics.AUC(name='auc')]
)

early_stop = EarlyStopping(monitor='val_auc', mode='max', patience=15, restore_best_weights=True, verbose=1)

history = model.fit(
    X_train_lstm_3d, 
    y_train,
    epochs=100,
    batch_size=512,
    validation_data=(X_test_lstm_3d, y_test),
    class_weight=weight_dict,
    callbacks=[early_stop],
    verbose=0 # Αλλάξτε το σε 1 αν θέλετε να βλέπετε την πρόοδο ανά epoch
)

y_prob_lstm = model.predict(X_test_lstm_3d).ravel()
y_pred_lstm = (y_prob_lstm >= 0.51).astype(int) 

print(classification_report(y_test, y_pred_lstm, target_names=['No Readmission (0)', 'Readmitted (1)']))

roc_auc_lstm = roc_auc_score(y_test, y_prob_lstm)
print(f"Fused Causal-LSTM ROC-AUC Score: {roc_auc_lstm:.4f}")

# VISUALIZATION
