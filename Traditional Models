### 1. Traditional XGBoost model implementation ###

negative_cases = (y_train == 0).sum()
positive_cases = (y_train == 1).sum()
scale_weight = negative_cases / positive_cases

xgb_model = xgb.XGBClassifier(
    n_estimators=500,               
    learning_rate=0.01,            
    max_depth=4,                    
    min_child_weight=5,             
    gamma=1,                        
    scale_pos_weight=scale_weight,  
    subsample=0.8,                  
    colsample_bytree=0.8,           
    eval_metric='auc',              
    early_stopping_rounds=40,      
    random_state=42,
    n_jobs=-1                       
)

# Training 
print("\nStarting Training... (Monitoring for Overfitting)")
xgb_model.fit(
    X_train_imputed, 
    y_train,
    eval_set=[(X_train_imputed, y_train), (X_test_imputed, y_test)],
    verbose=100 # Prints progress every 100 trees
)

# Predictions
y_prob = xgb_model.predict_proba(X_test_imputed)[:, 1]

precisions, recalls, thresholds = precision_recall_curve(y_test, y_prob)
# F1 Score formula: 2 * (Precision * Recall) / (Precision + Recall)
fscore = (2 * precisions * recalls) / (precisions + recalls + 1e-10) 
best_index = np.argmax(fscore)
optimal_threshold = thresholds[best_index]

y_pred_optimal = (y_prob >= optimal_threshold).astype(int)

# Evaluation 
print(classification_report(y_test, y_pred_optimal, target_names=['No Readmission (0)', 'Readmitted (1)']))

roc_auc = roc_auc_score(y_test, y_prob)
pr_auc = average_precision_score(y_test, y_prob)

#  Visualization 
plt.figure(figsize=(10, 6))

# Feature Importance
importances = xgb_model.feature_importances_
indices = np.argsort(importances)[-15:] 
features = X_train_imputed.columns

plt.barh(range(len(indices)), importances[indices], color='teal', align='center')
plt.yticks(range(len(indices)), [features[i] for i in indices])
plt.title('Top 15 Feature Importances (Traditional XGBoost)', fontsize=14, fontweight='bold')
plt.xlabel('Relative Importance (Gain)', fontsize=12)
plt.grid(axis='x', linestyle='--', alpha=0.7)

plt.tight_layout()
plt.savefig('Xgboost_traditional_feature.png', dpi=300, bbox_inches='tight')
plt.show()

