### 2. Traditional LSTM model implementation ###

# LSTM expects input shape: (Samples, Time_Steps, Features)
# We treat our static row as 1 Time_Step.

features_count = X_train_imputed.shape[1]

X_train_lstm = np.array(X_train_imputed).reshape((X_train_imputed.shape[0], 1, features_count))
X_test_lstm = np.array(X_test_imputed).reshape((X_test_imputed.shape[0], 1, features_count))


class_weights = compute_class_weight(
    class_weight='balanced', 
    classes=np.unique(y_train), 
    y=y_train
)
weight_dict = {0: class_weights[0], 1: class_weights[1]}
print(f"Class Weights Applied: {weight_dict}")

model = Sequential()

model.add(LSTM(
    64, 
    input_shape=(1, features_count), 
    activation='tanh'
))
model.add(BatchNormalization())
model.add(Dropout(0.5)) 

# Hidden Dense 
model.add(Dense(
    32, 
    activation='relu'
))
model.add(Dropout(0.4))

model.add(Dense(1, activation='sigmoid'))

model.compile(
    optimizer=tf.keras.optimizers.Adam(learning_rate=0.0005), 
    loss='binary_crossentropy',
    metrics=[tf.keras.metrics.AUC(name='auc')]
)

# Training 
early_stop = EarlyStopping(monitor='val_auc', mode='max', patience=15, restore_best_weights=True, verbose=1)

history = model.fit(
    X_train_lstm, 
    y_train,
    epochs=100,
    batch_size=512,
    validation_data=(X_test_lstm, y_test),
    class_weight=weight_dict,
    callbacks=[early_stop],
    verbose=1
)

# Predictions & Evaluation
# Neural Networks output probabilities by default
y_prob_lstm = model.predict(X_test_lstm).ravel()

y_pred_lstm = (y_prob_lstm >= 0.5).astype(int)

print(classification_report(y_test, y_pred_lstm, target_names=['No Readmission (0)', 'Readmitted (1)']))

roc_auc_lstm = roc_auc_score(y_test, y_prob_lstm)
print(f"LSTM ROC-AUC Score: {roc_auc_lstm:.4f}")

#  Visualization
fig, axes = plt.subplots(1, 2, figsize=(16, 6))

# Plot A: AUC over Epochs 
axes[0].plot(history.history['auc'], label='Train AUC')
axes[0].plot(history.history['val_auc'], label='Validation AUC')
axes[0].set_title('LSTM Model Learning Curve (AUC)', fontsize=14, fontweight='bold')
axes[0].set_xlabel('Epochs')
axes[0].set_ylabel('ROC-AUC')
axes[0].legend()
axes[0].grid(True, linestyle='--', alpha=0.7)

# Plot B: Confusion Matrix
cm = confusion_matrix(y_test, y_pred_lstm)
sns.heatmap(cm, annot=True, fmt='d', cmap='Purples', ax=axes[1], cbar=False,
            xticklabels=['No Readmission', 'Readmitted'],
            yticklabels=['No Readmission', 'Readmitted'])
axes[1].set_title('LSTM Confusion Matrix', fontsize=14, fontweight='bold')
axes[1].set_ylabel('Actual', fontsize=12)
axes[1].set_xlabel('Predicted', fontsize=12)

plt.tight_layout()
plt.show()

# Plot C: Feature extraction with Permutation
current_test_set = X_test_imputed 

traditional_model = model 

if len(current_test_set.shape) == 2:
    X_test_reshaped = np.expand_dims(current_test_set.values, axis=1)
else:
    X_test_reshaped = current_test_set

#  Αρχικό AUC 
baseline_preds = traditional_model.predict(X_test_reshaped, verbose=0)
baseline_auc = roc_auc_score(y_test, baseline_preds)

importances = []
cols_to_drop = [c for c in ['subject_id', 'hadm_id', 'readmitted_30d'] if c in current_test_set.columns]
feature_names = current_test_set.drop(columns=cols_to_drop).columns if hasattr(current_test_set, 'columns') else [f"Feature_{i}" for i in range(X_test_reshaped.shape[2])]

for i in range(X_test_reshaped.shape[2]): 
    X_test_permuted = X_test_reshaped.copy()
    np.random.shuffle(X_test_permuted[:, 0, i])
    
    permuted_preds = traditional_model.predict(X_test_permuted, verbose=0)
    permuted_auc = roc_auc_score(y_test, permuted_preds)
    
    drop_in_auc = max(0, baseline_auc - permuted_auc)
    importances.append(drop_in_auc)

importance_dict = dict(zip(feature_names, importances))
top_15_lstm = sorted(importance_dict.items(), key=lambda x: x[1], reverse=True)[:15]

features_lstm = [x[0] for x in top_15_lstm]
scores_lstm = [x[1] for x in top_15_lstm]

# Figure
plt.figure(figsize=(10, 8))
plt.barh(features_lstm[::-1], scores_lstm[::-1], color='steelblue')
plt.xlabel('Decrease in ROC-AUC Score (Permutation Importance)')
plt.title('Top 15 Feature Importances (Traditional LSTM via Permutation)')
plt.grid(axis='x', linestyle='--', alpha=0.7)
plt.savefig('Feature Importances (Traditional LSTM via Permutation).png', dpi=300, bbox_inches='tight')
plt.show()
